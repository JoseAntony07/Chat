# For a physical phone, replace these with your Mac's Wi-Fi IP address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8000

# For the hosted backend, use its HTTPS and secure WebSocket addresses instead:
# EXPO_PUBLIC_API_URL=https://YOUR-API.onrender.com/api
# EXPO_PUBLIC_WS_URL=wss://YOUR-API.onrender.com
