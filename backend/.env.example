# Django reads this file when the backend starts.
# Redis must be running for this channel layer setting to work.
#REDIS_URL=redis://127.0.0.1:6379/0

# Optional: allow a physical phone's backend origin for its WebSocket handshake.
# Replace this example with your Mac's Wi-Fi IP and uncomment it.
# WEBSOCKET_EXTRA_ALLOWED_ORIGINS=http://192.168.1.25:8000
